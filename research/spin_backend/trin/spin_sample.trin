// spin_backend research kernel — deterministic arithmetic expansion.
//
// Host feeds a seed string on stdin (typically hex of SHAKE(secret)).
// Kernel expands with fixed range work so *external* wall time is meaningful.
// Do NOT put timing or counters in this file (F1/S1): meter lives outside Trin.
//
// Output lines (parsed by TrinBackend):
//   SAMPLE_I=...
//   SAMPLE_S=...
//   SAMPLE_H=...
//   SAMPLE_N=...

fn main() {
    let seed_s: str = input("");
    let n: i32 = str_len(seed_s);
    // Length-dependent seed (host also absorbs full secret into SpinSample).
    let seed: i32 = (n > 0) | (n * 1103515245 + 12345) | 1;
    let rounds: i32 = 5000;
    let xs = range(rounds);
    let vals = for i in xs do (seed + i) * 1103515245 + 12345;
    let s = sum(for i in xs do (seed + i) * 1.0);
    let hard = (seed > 0) | (seed * 3 + 7) | 0;
    println(str_concat("SAMPLE_I=", to_str(seed)));
    println(str_concat("SAMPLE_S=", to_str(s)));
    println(str_concat("SAMPLE_H=", to_str(hard)));
    println(str_concat("SAMPLE_N=", to_str(len(vals))));
}
