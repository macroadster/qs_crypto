(* ═══════════════════════════════════════════════════════════════════
   QS-Crypto Formal Model — ProVerif

   This file models the protocol that Rust actually runs:

     src/protocols/pake.rs      — 2-message login, envelope, session key
     src/protocols/ratchet.rs   — DoubleRatchet::init + kem_ratchet_step
     src/protocols/session.rs   — Session::new composes PAKE ss → ratchet

   Transcripts and labels are taken from those files, not from an
   idealized 3-tuple (epk, env, salt) protocol.
   ═══════════════════════════════════════════════════════════════════ *)

(* ── Channels ──────────────────────────────────────────────────────
   - secch: out-of-band secure channel (used only during registration)
   - pubch: public (attacker-controlled) channel for login messages
*)
free secch: channel [private].
free pubch: channel.

(* ── Types ─────────────────────────────────────────────────────────*)
type key [large].            (* symmetric keys / shared secrets      *)
type skey [large].           (* KEM private key                      *)
type pkey [large].           (* KEM public key                       *)
type nonce [large].
type ciphertext [large].     (* KEM ciphertext                       *)
type envelope [large].       (* AEAD-encrypted blob                  *)
type password [large,private].

(* ── Primitive constructors ────────────────────────────────────────*)

(* KEM: IND-CCA2 ideal KEM (encaps/decaps) *)
fun pk(skey): pkey.
fun kem_encaps(pkey, nonce): ciphertext.
fun kem_shared(pkey, nonce): key [private].
reduc forall sk: skey, r: nonce;
  kem_decaps(sk, kem_encaps(pk(sk), r)) = kem_shared(pk(sk), r).

(* AEAD(key, nonce, aad, plaintext) — matches aead::encrypt / decrypt.
   PAKE envelope: AEAD(pwk, nonce, aad=pk, sk). Session messages reuse
   the same constructor with a derived nonce. *)
fun aead_enc(key, nonce, bitstring, bitstring): envelope.
reduc forall k: key, n: nonce, aad: bitstring, pt: bitstring;
  aead_dec(k, n, aad, aead_enc(k, n, aad, pt)) = pt.

(* Domain labels — byte-identical to the Rust strings / domain bytes. *)
const qs_pake_envelope: bitstring.           (* b"qs-pake-envelope" *)
const qs_session_domain_0x20: bitstring.     (* 0x20 *)
const qs_ratchet_root: bitstring.            (* b"qs-ratchet-root" *)
const qs_ratchet_chain_a: bitstring.         (* b"qs-ratchet-chain-a" *)
const qs_ratchet_chain_b: bitstring.         (* b"qs-ratchet-chain-b" *)
const qs_ratchet_kem: bitstring.             (* b"qs-ratchet-kem" *)
const qs_chain_msgkey: bitstring.            (* b"qs-chain-msgkey" *)
const qs_chain_next: bitstring.              (* b"qs-chain-next" *)
const qs_session_nonce: bitstring.           (* b"qs-session-nonce" *)
const empty_info: bitstring.
const client_hello: bitstring.               (* PakeClient::start marker *)
const dir_init: bitstring.
const dir_resp: bitstring.
const cnt0: bitstring.
const cnt1: bitstring.

(* pwk = SHAKE256("qs-pake-envelope" ‖ le64(len(pw)) ‖ pw
                 ‖ le64(len(salt)) ‖ salt ‖ info)
   See pake.rs shake_kdf. *)
fun shake_kdf(bitstring, password, nonce, bitstring): key.

(* session_key = SHAKE256(0x20 ‖ ss ‖ server_msg)
   server_msg is the entire server response (record ‖ kem_ct),
   not (epk, ct). See pake.rs shake_session_hash. *)
fun shake_session_hash(bitstring, key, bitstring): key.

(* SHAKE256(key ‖ label) — DoubleRatchet::init and symmetric_ratchet. *)
fun shake_derive(key, bitstring): key.

(* SHAKE256(root ‖ kem_ss ‖ "qs-ratchet-kem") → 64 bytes
   = new_root[0:32] ‖ new_send_chain[32:64]. See kem_ratchet_step. *)
fun shake_kem_ratchet(key, key, bitstring): bitstring.
fun kem_ratchet_new_root(bitstring): key.
fun kem_ratchet_new_chain(bitstring): key.

(* SHAKE256("qs-session-nonce" ‖ direction ‖ msg_number) → 16-byte nonce. *)
fun derive_nonce(bitstring, bitstring, bitstring): nonce.

(* ── Events for security queries ──────────────────────────────────*)

event ClientRegistered(pkey).
event ServerStored(pkey).
event ClientStartsLogin(pkey).
event ServerSendsResponse(pkey, ciphertext).
event ClientDerivesSession(pkey, key).
event ServerDerivesSession(pkey, key).

event SendMsg(key, bitstring).
event RecvMsg(key, bitstring).

event RatchetStepClient(key).    (* client performed a KEM ratchet *)
event CompromiseRootKey(key).    (* attacker learns root key       *)

(* ── Secret declarations ──────────────────────────────────────────*)

free secret_test: bitstring [private].
free msg1_test: bitstring [private].
free msg2_test: bitstring [private].
free msg_after_ratchet: bitstring [private].

(* ═══════════════════════════════════════════════════════════════════
   1. PAKE REGISTRATION  (secure channel)

   Matches pake_register:
     pwk = SHAKE256("qs-pake-envelope" ‖ …)
     envelope = AEAD(pwk, nonce, aad=pk, sk)   — encrypts only sk
     record  = (pk, env, salt, nonce)
   ═══════════════════════════════════════════════════════════════════ *)

let Registration(pw: password) =
  new sk: skey;
  let epk = pk(sk) in
  event ClientRegistered(epk);

  new salt: nonce;
  new env_nonce: nonce;
  let pwk = shake_kdf(qs_pake_envelope, pw, salt, empty_info) in
  let env = aead_enc(pwk, env_nonce, epk, sk) in

  out(secch, (epk, env, salt, env_nonce)).

let ServerStore() =
  in(secch, (epk: pkey, env: envelope, salt: nonce, env_nonce: nonce));
  event ServerStored(epk);
  out(pubch, (epk, env, salt, env_nonce)).

(* ═══════════════════════════════════════════════════════════════════
   2. PAKE LOGIN then SESSION  (public channel)

   2-message login matching PakeClient / PakeServer, then Session::new
   which calls DoubleRatchet::init with qs-ratchet-root / chain-a|b.
   ═══════════════════════════════════════════════════════════════════ *)

let ClientLoginThenSession(pw: password) =
  (* msg1: identity marker *)
  out(pubch, client_hello);

  (* msg2 = entire server response: record ‖ kem_ct *)
  in(pubch, (epk: pkey, env: envelope, salt: nonce, env_nonce: nonce, ct: ciphertext));
  let server_msg = (epk, env, salt, env_nonce, ct) in

  event ClientStartsLogin(epk);

  let pwk = shake_kdf(qs_pake_envelope, pw, salt, empty_info) in
  let sk: skey = aead_dec(pwk, env_nonce, epk, env) in
  let ss = kem_decaps(sk, ct) in

  (* Bind the entire server_msg, not (epk, ct). *)
  let session_key = shake_session_hash(qs_session_domain_0x20, ss, server_msg) in
  event ClientDerivesSession(epk, session_key);

  (* Session::new → DoubleRatchet::init *)
  let root = shake_derive(session_key, qs_ratchet_root) in
  let chain_a = shake_derive(session_key, qs_ratchet_chain_a) in
  let chain_b = shake_derive(session_key, qs_ratchet_chain_b) in

  (* Client treated as initiator: send_ck = chain_a *)
  let mk0 = shake_derive(chain_a, qs_chain_msgkey) in
  let ck1 = shake_derive(chain_a, qs_chain_next) in
  let n0 = derive_nonce(qs_session_nonce, dir_init, cnt0) in
  event SendMsg(mk0, msg1_test);
  out(pubch, aead_enc(mk0, n0, empty_info, msg1_test));

  let mk1 = shake_derive(ck1, qs_chain_msgkey) in
  let ck2 = shake_derive(ck1, qs_chain_next) in
  let n1 = derive_nonce(qs_session_nonce, dir_init, cnt1) in
  event SendMsg(mk1, msg2_test);
  out(pubch, aead_enc(mk1, n1, empty_info, msg2_test));

  (* kem_ratchet_step: SHAKE256(root ‖ kem_ss ‖ "qs-ratchet-kem") *)
  new rk_nonce: nonce;
  new peer_sk: skey;
  let peer_epk = pk(peer_sk) in
  let ratchet_ct = kem_encaps(peer_epk, rk_nonce) in
  let ratchet_ss = kem_shared(peer_epk, rk_nonce) in
  let expanded = shake_kem_ratchet(root, ratchet_ss, qs_ratchet_kem) in
  let new_root = kem_ratchet_new_root(expanded) in
  let new_chain = kem_ratchet_new_chain(expanded) in
  event RatchetStepClient(new_root);

  let mk2 = shake_derive(new_chain, qs_chain_msgkey) in
  let n2 = derive_nonce(qs_session_nonce, dir_init, cnt1) in
  event SendMsg(mk2, msg_after_ratchet);
  out(pubch, aead_enc(mk2, n2, empty_info, msg_after_ratchet)).

let ServerLoginThenSession() =
  in(pubch, (epk: pkey, env: envelope, salt: nonce, env_nonce: nonce));
  in(pubch, hello: bitstring);

  new r: nonce;
  let ct = kem_encaps(epk, r) in
  let ss = kem_shared(epk, r) in
  event ServerSendsResponse(epk, ct);

  (* Entire server_msg = record ‖ kem_ct *)
  let server_msg = (epk, env, salt, env_nonce, ct) in
  out(pubch, server_msg);

  let session_key = shake_session_hash(qs_session_domain_0x20, ss, server_msg) in
  event ServerDerivesSession(epk, session_key);

  (* Session::new → DoubleRatchet::init (same labels as the client) *)
  let root = shake_derive(session_key, qs_ratchet_root) in
  let chain_a = shake_derive(session_key, qs_ratchet_chain_a) in
  let chain_b = shake_derive(session_key, qs_ratchet_chain_b) in

  (* Server treated as responder: recv_ck = chain_a *)
  let mk0 = shake_derive(chain_a, qs_chain_msgkey) in
  let n0 = derive_nonce(qs_session_nonce, dir_init, cnt0) in
  in(pubch, enc_msg1: envelope);
  let m1 = aead_dec(mk0, n0, empty_info, enc_msg1) in
  event RecvMsg(mk0, m1);

  let ck1 = shake_derive(chain_a, qs_chain_next) in
  let mk1 = shake_derive(ck1, qs_chain_msgkey) in
  let n1 = derive_nonce(qs_session_nonce, dir_init, cnt1) in
  in(pubch, enc_msg2: envelope);
  let m2 = aead_dec(mk1, n1, empty_info, enc_msg2) in
  event RecvMsg(mk1, m2).

(* ═══════════════════════════════════════════════════════════════════
   3. SECURITY QUERIES
   ═══════════════════════════════════════════════════════════════════ *)

(* Q1: Session key secrecy — the attacker cannot learn secret_test *)
query attacker(secret_test).

(* Q2: Message secrecy — msg1 and msg2 are protected *)
query attacker(msg1_test).
query attacker(msg2_test).

(* Q3: Forward secrecy — msg_after_ratchet protected even if old
   chain keys are exposed before the ratchet step *)
query attacker(msg_after_ratchet).

(* Q4: Mutual authentication — if the client derives a session key,
   the server sent a ciphertext for the same public key.
   Correspondence only: no `new` binder inside the query. *)
query epk: pkey, sk: key, ct: ciphertext;
  event(ClientDerivesSession(epk, sk))
  ==> event(ServerSendsResponse(epk, ct)).

(* Q5: Agreement — if both derive session keys for the same pk,
   the keys must match *)
query epk: pkey, sk1: key, sk2: key;
  event(ClientDerivesSession(epk, sk1)) && event(ServerDerivesSession(epk, sk2))
  ==> sk1 = sk2.

(* ═══════════════════════════════════════════════════════════════════
   4. MAIN PROCESS

   Registration (one-shot) then unbounded login sessions, each of
   which composes PAKE → DoubleRatchet the way Session::new does.
   ═══════════════════════════════════════════════════════════════════ *)

free pw_alice: password [private].

process
  ( Registration(pw_alice) | ServerStore() )
  |
  ( !ClientLoginThenSession(pw_alice) | !ServerLoginThenSession() )
