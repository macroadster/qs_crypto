(* ═══════════════════════════════════════════════════════════════════
   QS-Crypto Formal Model — ProVerif
   Models: PAKE registration/login + Double Ratchet session
   ═══════════════════════════════════════════════════════════════════ *)

(* ── Channels ──────────────────────────────────────────────────────
   - secch: out-of-band secure channel (used only during registration)
   - pubch: public (attacker-controlled) channel for login messages
*)
free secch: channel [private].
free pubch: channel.

(* ── Types ─────────────────────────────────────────────────────────*)
type key [large].            (* symmetric keys / shared secrets      *)
type skey [large].           (* KEM private key                      *)
type pkey [large].           (* KEM public key                       *)
type nonce [large].
type ciphertext [large].     (* KEM ciphertext                       *)
type envelope [large].       (* AEAD-encrypted blob                  *)
type password [large,private].

(* ── Primitive constructors ────────────────────────────────────────*)

(* KEM: IND-CCA2 ideal KEM (encaps/decaps) *)
fun pk(skey): pkey.
fun kem_encaps(pkey, nonce): ciphertext.
fun kem_shared(pkey, nonce): key [private].
reduc forall sk: skey, r: nonce;
  kem_decaps(sk, kem_encaps(pk(sk), r)) = kem_shared(pk(sk), r).

(* AEAD: authenticated encryption *)
fun aead_enc(key, bitstring): envelope.
reduc forall k: key, m: bitstring;
  aead_dec(k, aead_enc(k, m)) = m.

(* KDF / hash: modeled as random oracles *)
fun shake_kdf(bitstring): key.
fun shake_session(key, bitstring): key.

(* Password-based key derivation *)
fun pwk_derive(password, nonce): key.

(* Symmetric ratchet: deterministic one-way chain *)
fun chain_next(key): key.
fun chain_msgkey(key): key.

(* KEM ratchet: derive new root + chain from root_key ‖ kem_ss *)
fun ratchet_root(key, key): key.
fun ratchet_chain(key, key): key.

(* ── Events for security queries ──────────────────────────────────*)

event ClientRegistered(pkey).
event ServerStored(pkey).
event ClientStartsLogin(pkey).
event ServerSendsResponse(pkey, ciphertext).
event ClientDerivesSession(pkey, key).
event ServerDerivesSession(pkey, key).

event SendMsg(key, bitstring).
event RecvMsg(key, bitstring).

event RatchetStepClient(key).    (* client performed a KEM ratchet *)
event CompromiseRootKey(key).    (* attacker learns root key       *)

(* ── Secret declarations ──────────────────────────────────────────*)

free secret_test: bitstring [private].
free msg1_test: bitstring [private].
free msg2_test: bitstring [private].
free msg_after_ratchet: bitstring [private].

(* ═══════════════════════════════════════════════════════════════════
   1. PAKE REGISTRATION  (secure channel)
   ═══════════════════════════════════════════════════════════════════ *)

let Registration(pw: password) =
  (* Client generates a KEM keypair *)
  new sk: skey;
  let epk = pk(sk) in
  event ClientRegistered(epk);

  (* Derive password key, encrypt private key into envelope *)
  new salt: nonce;
  let pwkey = pwk_derive(pw, salt) in
  let env = aead_enc(pwkey, (sk, epk)) in

  (* Send registration record to server over secure channel *)
  out(secch, (epk, env, salt)).

let ServerStore() =
  in(secch, (epk: pkey, env: envelope, salt: nonce));
  event ServerStored(epk);
  (* Server stores (epk, env, salt) — proceeds to login phase *)
  out(pubch, (epk, env, salt)).    (* make record available *)

(* ═══════════════════════════════════════════════════════════════════
   2. PAKE LOGIN  (public channel)
   ═══════════════════════════════════════════════════════════════════ *)

let ClientLogin(pw: password) =
  (* Receive server's response containing the registration record *)
  in(pubch, (epk: pkey, env: envelope, salt: nonce, ct: ciphertext));

  event ClientStartsLogin(epk);

  (* Recover private key from envelope *)
  let pwkey = pwk_derive(pw, salt) in
  let (sk: skey, epk2: pkey) = aead_dec(pwkey, env) in

  (* Decapsulate KEM ciphertext *)
  let ss = kem_decaps(sk, ct) in

  (* Derive session key bound to transcript *)
  let session_key = shake_session(ss, (epk, ct)) in
  event ClientDerivesSession(epk, session_key);

  (* Use session key to protect a secret message — tests secrecy *)
  let msg_key = chain_msgkey(session_key) in
  out(pubch, aead_enc(msg_key, secret_test)).

let ServerLogin() =
  (* Read stored record *)
  in(pubch, (epk: pkey, env: envelope, salt: nonce));

  (* Encapsulate a shared secret to the registered public key *)
  new r: nonce;
  let ct = kem_encaps(epk, r) in
  let ss = kem_shared(epk, r) in
  event ServerSendsResponse(epk, ct);

  (* Send record + ciphertext to client *)
  out(pubch, (epk, env, salt, ct));

  (* Derive session key bound to transcript *)
  let session_key = shake_session(ss, (epk, ct)) in
  event ServerDerivesSession(epk, session_key).

(* ═══════════════════════════════════════════════════════════════════
   3. DOUBLE RATCHET  (symmetric + KEM ratchet)
   ═══════════════════════════════════════════════════════════════════ *)

let RatchetSender(session_key: key) =
  (* --- Message 1: derive key from initial chain --- *)
  let ck0 = session_key in
  let mk0 = chain_msgkey(ck0) in
  let ck1 = chain_next(ck0) in
  event SendMsg(mk0, msg1_test);
  out(pubch, aead_enc(mk0, msg1_test));

  (* --- Message 2: next chain step --- *)
  let mk1 = chain_msgkey(ck1) in
  let ck2 = chain_next(ck1) in
  event SendMsg(mk1, msg2_test);
  out(pubch, aead_enc(mk1, msg2_test));

  (* --- KEM ratchet step --- *)
  new rk_nonce: nonce;
  new peer_sk: skey;
  let peer_epk = pk(peer_sk) in
  let ratchet_ct = kem_encaps(peer_epk, rk_nonce) in
  let ratchet_ss = kem_shared(peer_epk, rk_nonce) in
  let new_root = ratchet_root(ck2, ratchet_ss) in
  let new_chain = ratchet_chain(ck2, ratchet_ss) in
  event RatchetStepClient(new_root);

  (* --- Message 3: after ratchet, using new chain key --- *)
  let mk2 = chain_msgkey(new_chain) in
  event SendMsg(mk2, msg_after_ratchet);
  out(pubch, aead_enc(mk2, msg_after_ratchet)).

let RatchetReceiver(session_key: key) =
  (* Receive message 1 *)
  let ck0 = session_key in
  let mk0 = chain_msgkey(ck0) in
  in(pubch, enc_msg1: envelope);
  let m1 = aead_dec(mk0, enc_msg1) in
  event RecvMsg(mk0, m1);

  (* Receive message 2 *)
  let ck1 = chain_next(ck0) in
  let mk1 = chain_msgkey(ck1) in
  in(pubch, enc_msg2: envelope);
  let m2 = aead_dec(mk1, enc_msg2) in
  event RecvMsg(mk1, m2).

(* ═══════════════════════════════════════════════════════════════════
   4. SECURITY QUERIES
   ═══════════════════════════════════════════════════════════════════ *)

(* Q1: Session key secrecy — the attacker cannot learn secret_test *)
query attacker(secret_test).

(* Q2: Message secrecy — msg1 and msg2 are protected *)
query attacker(msg1_test).
query attacker(msg2_test).

(* Q3: Forward secrecy — msg_after_ratchet protected even if old
   chain keys are exposed before the ratchet step *)
query attacker(msg_after_ratchet).

(* Q4: Mutual authentication — if the client derives a session key,
   the server must have responded with a matching ciphertext *)
query epk: pkey, sk: key;
  event(ClientDerivesSession(epk, sk))
  ==> event(ServerSendsResponse(epk, kem_encaps(epk, new nonce))).

(* Q5: Agreement — if both derive session keys for the same pk,
   the keys must match *)
query epk: pkey, sk1: key, sk2: key;
  event(ClientDerivesSession(epk, sk1)) && event(ServerDerivesSession(epk, sk2))
  ==> sk1 = sk2.

(* ═══════════════════════════════════════════════════════════════════
   5. MAIN PROCESS
   ═══════════════════════════════════════════════════════════════════ *)

free pw_alice: password [private].

process
  (* Registration phase *)
  ( Registration(pw_alice) | ServerStore() )
  |
  (* Login phase — unbounded sessions *)
  ( !ClientLogin(pw_alice) | !ServerLogin() )